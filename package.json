{
  "name": "legacy-strangler-migration",
  "version": "0.1.0",
  "description": "Strangler Fig migration of a legacy SQL Server billing system to a NestJS service on PostgreSQL",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:all": "npm test && npm run test:int",
    "legacy:init": "tsx --env-file-if-exists=.env src/legacy/db/init.ts",
    "start:legacy": "node --env-file-if-exists=.env dist/legacy/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/shared/database/migrate.ts",
    "start:billing": "node --env-file-if-exists=.env dist/billing/main.js",
    "sync:backfill": "node --env-file-if-exists=.env dist/sync/main.js backfill",
    "sync:cdc": "node --env-file-if-exists=.env dist/sync/main.js cdc"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "express": "^5.2.1",
    "kysely": "^0.28.17",
    "mssql": "^12.7.0",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "5.7",
    "typescript-eslint": "^8.69.0"
  }
}
