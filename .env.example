NODE_ENV=development
LOG_LEVEL=info

# Legacy SQL Server (docker compose: host port 1434)
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=1434
LEGACY_DB_USER=sa
LEGACY_DB_PASSWORD=Legacy_Passw0rd!
LEGACY_DB_NAME=LegacyBilling
LEGACY_DB_TRUST_CERT=true

# Modern PostgreSQL (docker compose: host port 5434)
DATABASE_URL=postgres://billing:billing@localhost:5434/billing

# Gateway (strangler facade)
LEGACY_BASE_URL=http://localhost:3401
MODERN_BASE_URL=http://localhost:3402
ADMIN_TOKEN=local-admin-token-change-me
FLAG_CACHE_TTL_MS=2000
